{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/willie-yao/aster/setup-handoff-v2.json",
  "title": "Aster setup to diagnostic authoring handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_digest",
    "engine",
    "consumer",
    "source",
    "discovery",
    "artifact_location",
    "test_infra",
    "deployment",
    "prompt",
    "apply_result",
    "artifact_smoke",
    "doctor",
    "next_phase"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "plan_digest": {
      "$ref": "#/$defs/sha256"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "modified": {
          "type": "boolean"
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "project_id",
        "name"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "revision": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "status": {
              "enum": [
                "resolved",
                "unresolved"
              ]
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "digest",
        "jobs"
      ],
      "properties": {
        "selector": {
          "enum": [
            "testgrid",
            "bucket",
            "bucket-exact-jobs"
          ]
        },
        "testgrid": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "gcsweb_base": {
          "type": "string"
        },
        "exact_jobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "catalog_revision": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "required": [
        "mode",
        "artifact_access",
        "ai_enabled"
      ],
      "properties": {
        "mode": {
          "enum": [
            "pages",
            "k8s"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_access": {
          "enum": [
            "public",
            "authenticated",
            "private",
            "unknown"
          ]
        },
        "ai_enabled": {
          "type": "boolean"
        },
        "k8s_storage_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
        },
        "k8s_existing_claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
        }
      }
    },
    "prompt": {
      "type": "object",
      "required": [
        "candidate_sha256",
        "active_sha256",
        "status",
        "baseline_status",
        "active_path",
        "source_only_candidate",
        "requested_mode",
        "source"
      ],
      "properties": {
        "original_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "active_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "preserved-existing",
            "replaced-with-source-only-baseline",
            "created-source-only-baseline"
          ]
        },
        "baseline_status": {
          "const": "source-only-unvalidated"
        },
        "active_path": {
          "type": "string",
          "minLength": 1
        },
        "source_only_candidate": {
          "type": "string",
          "minLength": 1
        },
        "requested_mode": {
          "enum": [
            "handoff",
            "todo-template",
            "agent"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "apply_result": {
      "$ref": "#/$defs/apply_result"
    },
    "artifact_smoke": {
      "type": "object",
      "required": [
        "read_only",
        "builds_per_job",
        "jobs"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "builds_per_job": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "jobs": {
          "type": "array"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "doctor": {
      "type": "object",
      "required": [
        "project_dir",
        "checks"
      ],
      "properties": {
        "project_dir": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "unresolved_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "next_phase": {
      "type": "string",
      "minLength": 1
    },
    "artifact_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "gcs",
            "gcsweb",
            "local"
          ]
        },
        "bucket": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "web_base": {
          "type": "string"
        },
        "prow_base": {
          "type": "string"
        }
      }
    },
    "test_infra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved",
            "not_applicable"
          ]
        },
        "config_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "required": [
        "owner",
        "name",
        "full_name"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "full_name": {
          "type": "string",
          "minLength": 3
        },
        "visibility": {
          "type": "string"
        },
        "default_branch": {
          "type": "string"
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "name",
        "job_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "job_type": {
          "enum": [
            "periodic",
            "presubmit"
          ]
        },
        "repo": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "config_file": {
          "type": "string"
        }
      }
    },
    "applied_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "sha256",
        "status",
        "ownership",
        "matches_reviewed_plan"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "create",
            "replace",
            "preserve"
          ]
        },
        "ownership": {
          "enum": [
            "engine_generated",
            "consumer_owned"
          ]
        },
        "matches_reviewed_plan": {
          "const": true
        }
      }
    },
    "apply_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_digest",
        "destination",
        "files",
        "matches_reviewed_plan",
        "prompt"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/applied_file"
          }
        },
        "matches_reviewed_plan": {
          "const": true
        },
        "prompt": {
          "type": "object",
          "required": [
            "candidate_sha256",
            "active_sha256",
            "status"
          ],
          "properties": {
            "original_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "candidate_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "active_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "deployment": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "k8s_storage_class"
                  ]
                },
                {
                  "required": [
                    "k8s_existing_claim"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "deployment": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "k8s"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "oneOf": [
                    {
                      "required": [
                        "k8s_storage_class"
                      ]
                    },
                    {
                      "required": [
                        "k8s_existing_claim"
                      ]
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "pages"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "k8s_storage_class"
                        ]
                      },
                      {
                        "required": [
                          "k8s_existing_claim"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
