{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prow-ai-dashboard Helm values",
  "description": "Configuration contract for the prow-ai-dashboard Helm chart. Cross-field and cluster-dependent constraints are also enforced by chart templates.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": {
      "type": "object",
      "description": "A string-valued Kubernetes metadata or selector map.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "freeFormObject": {
      "type": "object",
      "description": "A Kubernetes pass-through object.",
      "additionalProperties": true
    },
    "freeFormArray": {
      "type": "array",
      "description": "A Kubernetes pass-through object list.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "envVars": {
      "type": "array",
      "description": "Kubernetes core/v1 EnvVar entries.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      }
    },
    "tolerations": {
      "type": "array",
      "description": "A Kubernetes pass-through object list.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "networkPolicyRules": {
      "type": "array",
      "description": "networking.k8s.io/v1 NetworkPolicy ingress rules.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "networkPolicyPeers": {
      "type": "array",
      "description": "Legacy networking.k8s.io/v1 NetworkPolicy peers.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "image": {
      "type": "object",
      "description": "Container image configuration.",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository."
        },
        "tag": {
          "type": "string",
          "description": "Container image tag. An empty value follows the chart image fallback."
        },
        "pullPolicy": {
          "type": "string",
          "description": "Kubernetes image pull policy.",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ]
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "description": "Values shared by the engine, analyzer, and fixer images.",
      "properties": {
        "imageTag": {
          "type": "string",
          "description": "Shared image tag. Empty falls back to the chart appVersion."
        }
      },
      "additionalProperties": false,
      "required": [
        "imageTag"
      ]
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Kubernetes image pull Secrets.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Secret name."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override for the chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override for the fully qualified release name."
    },
    "mode": {
      "type": "string",
      "description": "Select the single dashboard data writer.",
      "enum": [
        "watch",
        "cron"
      ]
    },
    "analysisCache": {
      "type": "object",
      "description": "AI cache namespace controls.",
      "properties": {
        "generation": {
          "description": "Reversible cache generation. Empty preserves historical keys; nonnegative integers are also accepted.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "generation"
      ]
    },
    "analysisRuntime": {
      "type": "object",
      "description": "Failure analysis runtime selection.",
      "properties": {
        "type": {
          "type": "string",
          "description": "Analysis runtime implementation.",
          "enum": [
            "inprocess",
            "orka-container"
          ]
        },
        "orkaContainer": {
          "type": "object",
          "description": "Experimental Orka container analysis settings.",
          "properties": {
            "namespace": {
              "type": "string",
              "description": "Analysis namespace. Empty creates a retained release-scoped namespace."
            },
            "api": {
              "type": "string",
              "description": "Orka result API URL."
            },
            "apiAuth": {
              "type": "object",
              "description": "Orka result API authentication.",
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "description": "Dashboard-namespace Secret containing a static Orka API token. Empty uses a projected ServiceAccount token."
                },
                "tokenKey": {
                  "type": "string",
                  "description": "Secret key containing the Orka API token."
                }
              },
              "additionalProperties": false,
              "required": [
                "existingSecret",
                "tokenKey"
              ]
            },
            "maxConcurrentTasks": {
              "type": "integer",
              "description": "Maximum concurrent analyzer Tasks.",
              "minimum": 1,
              "maximum": 999
            },
            "pollInterval": {
              "type": "string",
              "description": "Interval between Orka Task status polls."
            },
            "taskTimeout": {
              "type": "string",
              "description": "Per-Task timeout. It must exceed the project AI timeout plus lifecycle margin."
            },
            "retries": {
              "type": "integer",
              "description": "Orka Task retry count.",
              "minimum": 0,
              "maximum": 99
            },
            "image": {
              "type": "object",
              "description": "Analyzer Task image.",
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Container image repository."
                },
                "tag": {
                  "type": "string",
                  "description": "Container image tag. An empty value follows the chart image fallback."
                },
                "pullPolicy": {
                  "type": "string",
                  "description": "Kubernetes image pull policy.",
                  "enum": [
                    "IfNotPresent"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "repository",
                "tag",
                "pullPolicy"
              ]
            },
            "modelAuth": {
              "type": "object",
              "description": "Model credential reference in the analysis namespace.",
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "description": "Existing model credential Secret name."
                },
                "tokenKey": {
                  "type": "string",
                  "description": "Secret key containing the model token."
                }
              },
              "additionalProperties": false,
              "required": [
                "existingSecret",
                "tokenKey"
              ]
            },
            "state": {
              "type": "object",
              "description": "Encrypted analyzer state key configuration.",
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "description": "Existing state Secret name in both dashboard and analysis namespaces."
                },
                "key": {
                  "type": "string",
                  "description": "Secret key containing the state key."
                }
              },
              "additionalProperties": false,
              "required": [
                "existingSecret",
                "key"
              ]
            },
            "nodeSelector": {
              "$ref": "#/definitions/stringMap"
            },
            "tolerations": {
              "$ref": "#/definitions/tolerations"
            },
            "affinity": {
              "$ref": "#/definitions/freeFormObject"
            }
          },
          "additionalProperties": false,
          "required": [
            "namespace",
            "api",
            "apiAuth",
            "maxConcurrentTasks",
            "pollInterval",
            "taskTimeout",
            "retries",
            "image",
            "modelAuth",
            "state",
            "nodeSelector",
            "tolerations",
            "affinity"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "orkaContainer"
      ]
    },
    "orka": {
      "type": "object",
      "description": "Orka integration shared by analysis, source investigation, and fix generation.",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "Namespace of the separately installed Orka release."
        },
        "fixRuntime": {
          "type": "object",
          "description": "Orka fix generation settings.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable Orka RBAC and the git-capable fixer runtime."
            },
            "image": {
              "type": "object",
              "description": "Fixer image.",
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Container image repository."
                },
                "tag": {
                  "type": "string",
                  "description": "Container image tag. An empty value follows the chart image fallback."
                },
                "pullPolicy": {
                  "type": "string",
                  "description": "Kubernetes image pull policy.",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "repository",
                "tag",
                "pullPolicy"
              ]
            },
            "admission": {
              "type": "object",
              "description": "Fail-closed admission contract for dashboard-created Orka fix Tasks.",
              "properties": {
                "agentRef": {
                  "type": "string",
                  "description": "Exact Orka Agent name allowed for fix generation."
                },
                "repository": {
                  "type": "object",
                  "description": "Exact GitHub repository allowed in fix Task workspaces.",
                  "properties": {
                    "owner": {
                      "type": "string",
                      "description": "Approved GitHub repository owner."
                    },
                    "name": {
                      "type": "string",
                      "description": "Approved GitHub repository name."
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "owner",
                    "name"
                  ]
                },
                "maxTurns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "Exact maximum agent turns allowed by admission."
                },
                "allowBash": {
                  "type": "boolean",
                  "description": "Exact Bash policy allowed by admission."
                },
                "timeout": {
                  "type": "string",
                  "pattern": "^([1-9]|[12][0-9]|30)m$",
                  "description": "Exact Task timeout, from 1m through 30m."
                },
                "retries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2,
                  "description": "Exact Orka Task retry count allowed by admission."
                }
              },
              "additionalProperties": false,
              "required": [
                "agentRef",
                "repository",
                "maxTurns",
                "allowBash",
                "timeout",
                "retries"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "image",
            "admission"
          ]
        },
        "rbac": {
          "type": "object",
          "description": "Orka ServiceAccount and Role management.",
          "properties": {
            "create": {
              "type": "boolean",
              "description": "Create the dashboard Orka ServiceAccount and Roles."
            },
            "serviceAccountName": {
              "type": "string",
              "description": "Existing Orka ServiceAccount name when chart-managed RBAC is disabled."
            }
          },
          "additionalProperties": false,
          "required": [
            "create",
            "serviceAccountName"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "namespace",
        "fixRuntime",
        "rbac"
      ]
    },
    "persistence": {
      "type": "object",
      "description": "Shared dashboard output and AI cache storage.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create or mount shared persistent storage."
        },
        "existingClaim": {
          "type": "string",
          "description": "Existing ReadWriteMany PersistentVolumeClaim name."
        },
        "retain": {
          "type": "boolean",
          "description": "Retain chart-managed data when the release or claim changes."
        },
        "accessMode": {
          "type": "string",
          "description": "PersistentVolumeClaim access mode.",
          "enum": [
            "ReadWriteMany"
          ]
        },
        "size": {
          "type": "string",
          "description": "Requested PersistentVolumeClaim capacity."
        },
        "storageClass": {
          "type": "string",
          "description": "ReadWriteMany StorageClass name. Empty uses the cluster default."
        },
        "mountPath": {
          "type": "string",
          "description": "Shared volume mount path in dashboard containers."
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingClaim",
        "retain",
        "accessMode",
        "size",
        "storageClass",
        "mountPath"
      ]
    },
    "project": {
      "type": "object",
      "description": "Consumer project bundle mounted into dashboard workloads.",
      "properties": {
        "existingConfigMap": {
          "type": "string",
          "description": "Existing ConfigMap containing project.yaml and system.md."
        },
        "config": {
          "type": "string",
          "description": "Inline project.yaml content, normally supplied with --set-file."
        },
        "systemPrompt": {
          "type": "string",
          "description": "Inline prompts/system.md content, normally supplied with --set-file."
        },
        "skills": {
          "type": "object",
          "description": "Consumer skill filename to YAML content map.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "mountPath": {
          "type": "string",
          "description": "Project bundle mount path."
        },
        "materializer": {
          "type": "object",
          "description": "Project bundle materializer used by Orka container analysis.",
          "properties": {
            "image": {
              "type": "object",
              "description": "Materializer image.",
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Container image repository."
                },
                "tag": {
                  "type": "string",
                  "description": "Container image tag. An empty value follows the chart image fallback."
                },
                "pullPolicy": {
                  "type": "string",
                  "description": "Kubernetes image pull policy.",
                  "enum": [
                    "IfNotPresent"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "repository",
                "tag",
                "pullPolicy"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "image"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "existingConfigMap",
        "config",
        "systemPrompt",
        "skills",
        "mountPath",
        "materializer"
      ]
    },
    "ai": {
      "type": "object",
      "description": "AI provider coordinates and credential references.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable AI failure analysis."
        },
        "api": {
          "type": "string",
          "description": "Provider request API.",
          "enum": [
            "chat_completions",
            "responses"
          ]
        },
        "endpoint": {
          "type": "string",
          "description": "Absolute provider endpoint URL."
        },
        "model": {
          "type": "string",
          "description": "Provider model identifier."
        },
        "contextWindowTokens": {
          "description": "Total provider context window. Use 0 for provider metadata or the engine fallback.",
          "anyOf": [
            {
              "type": "integer",
              "enum": [
                0
              ]
            },
            {
              "type": "integer",
              "minimum": 9217,
              "maximum": 1000000000
            }
          ]
        },
        "token": {
          "type": "string",
          "description": "Inline provider token. Prefer existingSecret in production."
        },
        "existingSecret": {
          "type": "string",
          "description": "Existing provider credential Secret name."
        },
        "tokenSecretKey": {
          "type": "string",
          "description": "Secret key containing the provider token."
        },
        "githubReadToken": {
          "type": "string",
          "description": "Inline read-only GitHub source token. Prefer githubReadTokenSecretName."
        },
        "githubReadTokenSecretName": {
          "type": "string",
          "description": "Existing read-only GitHub source credential Secret name."
        },
        "githubReadTokenSecretKey": {
          "type": "string",
          "description": "Secret key containing the GitHub read token."
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "api",
        "endpoint",
        "model",
        "contextWindowTokens",
        "token",
        "existingSecret",
        "tokenSecretKey",
        "githubReadToken",
        "githubReadTokenSecretName",
        "githubReadTokenSecretKey"
      ]
    },
    "fetcher": {
      "type": "object",
      "description": "Fetcher, worker, and CronJob behavior.",
      "properties": {
        "schedule": {
          "type": "string",
          "description": "Cron schedule used in cron mode."
        },
        "concurrencyPolicy": {
          "type": "string",
          "description": "CronJob concurrency policy.",
          "enum": [
            "Allow",
            "Forbid",
            "Replace"
          ]
        },
        "suspend": {
          "type": "boolean",
          "description": "Suspend cron-mode scheduled starts."
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "description": "Successful CronJob history limit.",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "description": "Failed CronJob history limit.",
          "minimum": 0
        },
        "restartPolicy": {
          "type": "string",
          "description": "CronJob pod restart policy. Empty selects a runtime-specific default.",
          "enum": [
            "",
            "Never",
            "OnFailure"
          ]
        },
        "backoffLimit": {
          "type": "integer",
          "description": "CronJob retry limit. -1 selects a runtime-specific default.",
          "minimum": -1,
          "maximum": 2147483647
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "description": "CronJob hard deadline. Zero omits the deadline.",
          "minimum": 0
        },
        "watchInterval": {
          "type": "string",
          "description": "Watch-mode incremental refresh interval."
        },
        "reconcileInterval": {
          "type": "string",
          "description": "Watch-mode full reconciliation interval."
        },
        "buildsPerJob": {
          "type": "integer",
          "description": "Prow build history depth per job.",
          "minimum": 1
        },
        "workers": {
          "type": "integer",
          "description": "Concurrent artifact fetch workers.",
          "minimum": 1
        },
        "timeout": {
          "type": "string",
          "description": "Discovery and artifact fetch timeout."
        },
        "includePresubmits": {
          "type": "boolean",
          "description": "Include presubmit jobs."
        },
        "extraEnv": {
          "$ref": "#/definitions/envVars"
        },
        "resources": {
          "$ref": "#/definitions/freeFormObject"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeFormObject"
        }
      },
      "additionalProperties": false,
      "required": [
        "schedule",
        "concurrencyPolicy",
        "suspend",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit",
        "restartPolicy",
        "backoffLimit",
        "activeDeadlineSeconds",
        "watchInterval",
        "reconcileInterval",
        "buildsPerJob",
        "workers",
        "timeout",
        "includePresubmits",
        "extraEnv",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity"
      ]
    },
    "server": {
      "type": "object",
      "description": "Dashboard API and SPA server configuration.",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "description": "Server Deployment replica count.",
          "minimum": 1
        },
        "staticDir": {
          "type": "string",
          "description": "Path to the SPA files in the server image."
        },
        "port": {
          "type": "integer",
          "description": "Server container port.",
          "minimum": 1,
          "maximum": 65535
        },
        "extraEnv": {
          "$ref": "#/definitions/envVars"
        },
        "security": {
          "type": "object",
          "description": "Server HTTP security settings.",
          "properties": {
            "hsts": {
              "type": "object",
              "description": "HTTP Strict Transport Security settings.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Send the chart HSTS policy."
                }
              },
              "additionalProperties": false,
              "required": [
                "enabled"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "hsts"
          ]
        },
        "development": {
          "type": "object",
          "description": "Local development-only server settings.",
          "properties": {
            "allowInsecureCookies": {
              "type": "boolean",
              "description": "Allow OAuth cookies over local HTTP. Never enable in a deployed dashboard."
            }
          },
          "additionalProperties": false,
          "required": [
            "allowInsecureCookies"
          ]
        },
        "chat": {
          "type": "object",
          "description": "Authenticated analysis chat settings.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable read-only authenticated analysis chat."
            },
            "timeout": {
              "type": "string",
              "description": "Per-turn model timeout."
            },
            "correctionsEnabled": {
              "type": "boolean",
              "description": "Enable reviewed chat corrections."
            },
            "sourceInvestigation": {
              "type": "object",
              "description": "Authenticated source investigation settings.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable source investigation from analysis chat."
                },
                "serviceAccountName": {
                  "type": "string",
                  "description": "Existing Orka ServiceAccount name when chart-managed RBAC is disabled."
                },
                "maxPerSession": {
                  "type": "integer",
                  "description": "Maximum source investigations per chat session.",
                  "minimum": 1
                },
                "maxActivePerOwner": {
                  "type": "integer",
                  "description": "Maximum active source investigations per owner.",
                  "minimum": 1
                },
                "admission": {
                  "type": "object",
                  "description": "Fail-closed admission contract for source investigation Tasks.",
                  "properties": {
                    "agentRef": {
                      "type": "string"
                    },
                    "repository": {
                      "type": "object",
                      "properties": {
                        "owner": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "owner",
                        "name"
                      ]
                    },
                    "gitSecret": {
                      "type": "string",
                      "description": "Exact read-only workspace Git Secret."
                    },
                    "maxTurns": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "timeout": {
                      "type": "string",
                      "pattern": "^(([0-9]+([.][0-9]+)?)|([.][0-9]+))(ns|us|\u00b5s|\u03bcs|ms|s|m|h)((([0-9]+([.][0-9]+)?)|([.][0-9]+))(ns|us|\u00b5s|\u03bcs|ms|s|m|h))*$"
                    },
                    "retries": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "agentRef",
                    "repository",
                    "gitSecret",
                    "maxTurns",
                    "timeout",
                    "retries"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "enabled",
                "serviceAccountName",
                "maxPerSession",
                "maxActivePerOwner",
                "admission"
              ]
            },
            "sessionTTL": {
              "type": "string",
              "description": "Persisted chat session lifetime."
            },
            "maxSessions": {
              "type": "integer",
              "description": "Maximum stored chat sessions.",
              "minimum": 1
            },
            "maxSessionsPerOwner": {
              "type": "integer",
              "description": "Maximum stored chat sessions per owner.",
              "minimum": 1
            },
            "maxActiveTurnsPerOwner": {
              "type": "integer",
              "description": "Maximum active chat turns per owner.",
              "minimum": 1
            },
            "requestsPerMinute": {
              "type": "integer",
              "description": "Per-owner chat request rate limit.",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "timeout",
            "correctionsEnabled",
            "sourceInvestigation",
            "sessionTTL",
            "maxSessions",
