+// transientWithoutTimeline reports whether the final answer claims
+// is_transient=true while the model never called verify_timeline to confirm it.
+// It backs the critique gate: a transient verdict must be earned with a timeline
+// confirmation, matching the engine's "default to bug unless proven" contract.
+func transientWithoutTimeline(content string, messages []llm.Message) bool {
+	compact := strings.NewReplacer(" ", "", "\n", "", "\t", "").Replace(content)
+	if !strings.Contains(compact, `"is_transient":true`) {
+		return false
+	}
+	for _, m := range messages {
+		for _, tc := range m.ToolCalls {
+			name := strings.ToLower(tc.Name)
+			if strings.Contains(name, "verify-timeline") || strings.Contains(name, "verify_timeline") {
+				return false
+			}
+		}
+	}
+	return true
