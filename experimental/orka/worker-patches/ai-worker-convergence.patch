+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"path"
+	"strings"
+
+	corev1alpha1 "github.com/orka-agents/orka/api/v1alpha1"
+	"github.com/orka-agents/orka/internal/llm"
+	"github.com/orka-agents/orka/internal/workerenv"
+)
+
+type validatedAnalysisCall struct {
+	Analysis validatedAnalysis `json:"analysis"`
+}
+
+type validatedAnalysis struct {
+	Summary         string   `json:"summary"`
+	IsTransient     *bool    `json:"is_transient"`
+	RootCause       string   `json:"root_cause"`
+	Severity        string   `json:"severity"`
+	SuggestedFix    string   `json:"suggested_fix"`
+	RelevantFiles   []string `json:"relevant_files"`
+	GCSBytes        *int     `json:"gcs_bytes,omitempty"`
+	ValidationToken string   `json:"validation_token,omitempty"`
+}
+
+type validationToolResult struct {
+	GCSBytes        *int   `json:"gcs_bytes"`
+	ValidationToken string `json:"validation_token"`
+}
+
+func isAnalysisValidationTool(name string) bool {
+	normalized := strings.ReplaceAll(strings.ToLower(strings.TrimSpace(name)), "_", "-")
+	return normalized == "validate-analysis" || strings.HasPrefix(normalized, "validate-analysis-") ||
+		normalized == "submit-analysis" || strings.HasPrefix(normalized, "submit-analysis-")
+}
+
+func isFlatAnalysisSubmissionTool(name string) bool {
+	normalized := strings.ReplaceAll(strings.ToLower(strings.TrimSpace(name)), "_", "-")
+	return normalized == "submit-analysis" || strings.HasPrefix(normalized, "submit-analysis-")
+}
+
+func isTimelineVerificationTool(name string) bool {
+	normalized := strings.ReplaceAll(strings.ToLower(strings.TrimSpace(name)), "_", "-")
+	return normalized == "verify-timeline" || strings.HasPrefix(normalized, "verify-timeline-")
+}
+
+func isAnalysisReadArtifactTool(name string) bool {
+	normalized := strings.ReplaceAll(strings.ToLower(strings.TrimSpace(name)), "_", "-")
+	return normalized == "read-artifact" || strings.HasPrefix(normalized, "read-artifact-")
+}
+
+func validatedAnalysisResult(toolName string, args json.RawMessage, result string) (string, bool, error) {
+	if !isAnalysisValidationTool(toolName) {
+		return "", false, nil
+	}
+	var call validatedAnalysisCall
+	if isFlatAnalysisSubmissionTool(toolName) {
+		if err := json.Unmarshal(args, &call.Analysis); err != nil {
+			return "", true, fmt.Errorf("parse submit_analysis arguments: %w", err)
+		}
+	} else if err := json.Unmarshal(args, &call); err != nil {
+		return "", true, fmt.Errorf("parse validate_analysis arguments: %w", err)
+	}
+	if err := validateAnalysisShape(call.Analysis); err != nil {
+		return "", true, err
+	}
+	var validation validationToolResult
+	if err := json.Unmarshal([]byte(result), &validation); err != nil {
+		return "", true, fmt.Errorf("parse validate_analysis result: %w", err)
+	}
+	if validation.GCSBytes == nil || *validation.GCSBytes < 0 {
+		return "", true, fmt.Errorf("validate_analysis result has no gcs_bytes")
+	}
+	if strings.TrimSpace(validation.ValidationToken) == "" {
+		return "", true, fmt.Errorf("validate_analysis result has no validation_token")
+	}
+	call.Analysis.GCSBytes = validation.GCSBytes
+	call.Analysis.ValidationToken = validation.ValidationToken
+	final, err := json.Marshal(call.Analysis)
+	if err != nil {
+		return "", true, fmt.Errorf("marshal validated analysis: %w", err)
+	}
+	return string(final), true, nil
+}
+
+func validateAnalysisShape(a validatedAnalysis) error {
+	if strings.TrimSpace(a.Summary) == "" {
+		return fmt.Errorf("analysis.summary is required")
+	}
+	if strings.TrimSpace(a.RootCause) == "" {
+		return fmt.Errorf("analysis.root_cause is required")
+	}
+	switch strings.ToLower(strings.TrimSpace(a.Severity)) {
+	case "critical", "high", "medium", "low":
+	default:
+		return fmt.Errorf("analysis.severity %q is invalid", a.Severity)
+	}
+	if a.IsTransient == nil {
+		return fmt.Errorf("analysis.is_transient is required")
+	}
+	if strings.TrimSpace(a.SuggestedFix) == "" {
+		return fmt.Errorf("analysis.suggested_fix is required")
+	}
+	if a.RelevantFiles == nil {
+		return fmt.Errorf("analysis.relevant_files is required")
+	}
+	return nil
+}
+
+func analysisToolNames(
+	tools []llm.Tool,
+	customTools map[string]*corev1alpha1.Tool,
+) (validation, timeline map[string]bool, finalization []llm.Tool) {
+	validation = map[string]bool{}
+	timeline = map[string]bool{}
+	for _, tool := range tools {
+		actual := resolvedCustomToolName(tool.Name, customTools)
+		switch {
+		case isAnalysisValidationTool(actual):
+			validation[tool.Name] = true
+			finalization = append(finalization, tool)
+		case isTimelineVerificationTool(actual):
+			timeline[tool.Name] = true
+			finalization = append(finalization, tool)
+		}
+	}
+	return validation, timeline, finalization
+}
+
+func analysisEvidenceRepairReader(
+	tools []llm.Tool,
+	customTools map[string]*corev1alpha1.Tool,
+) (llm.Tool, bool) {
+	for _, tool := range tools {
+		actual := resolvedCustomToolName(tool.Name, customTools)
+		if isAnalysisReadArtifactTool(actual) {
+			return tool, true
+		}
+	}
+	return llm.Tool{}, false
+}
+
+func normalizedValidationFailure(err error) string {
+	if err == nil {
+		return ""
+	}
+	return strings.Join(strings.Fields(err.Error()), " ")
+}
+
+func validatedAnalysisIsTransient(result string) bool {
+	var analysis validatedAnalysis
+	return json.Unmarshal([]byte(result), &analysis) == nil && analysis.IsTransient != nil && *analysis.IsTransient
+}
+
+const (
+	analysisLoopMaxIterations     = 25
+	analysisValidationFocusRounds = analysisMaxEvidenceRepairToolCalls + 3
+	maxValidationFailures         = 3
+	maxValidationFinalRetries     = 2
+	maxTransientCritiqueRetries   = 2
+	maxEmptyFinalRetries          = 1
+	defaultSubmissionToolName     = "validate_analysis"
+	defaultTimelineToolName       = "verify_timeline"
+	validationRequiredPrompt      = "The final answer cannot be accepted until validate_analysis succeeds. " +
+		"Call validate_analysis now with the complete final analysis and every supporting evidence token. " +
+		`Always include "relevant_files" as an array; use [] when no source files apply. ` +
+		"Do not return prose or final JSON before validation succeeds."
+	validationFocusPrompt = "You have reached the initial investigation budget. Stop broad investigation. " +
+		"If is_transient is true, call verify_timeline first unless it already succeeded. " +
+		`Then call validate_analysis exactly once. Always include "relevant_files" as an array; ` +
+		"use [] when no source files apply, and include all supporting evidence tokens."
+	toolsFreeFinalPrompt = "You have reached your tool-use budget. Do NOT call any more tools. " +
+		"Using the information already gathered, provide the final answer in the format requested by the Task."
+	emptyFinalPrompt = "Your last response was empty. Do NOT call any tools. " +
+		"Provide the final answer now in the format requested by the Task, using the information already gathered."
+	transientCritiquePrompt = "You set is_transient=true but never called verify_timeline " +
+		"to confirm the failing operation. " +
+		"A bare context deadline or transient-signature match is not proof. Call verify_timeline now. " +
+		"If you cannot prove a known transient class, set is_transient=false, then re-emit the final JSON."
+	transientValidationPrompt = "The validated analysis sets is_transient=true " +
+		"without a successful verify_timeline call. " +
+		"Call verify_timeline for the specific failing operation, then call validate_analysis again."
+	evidenceRepairPrompt = "Validation found required evidence that has not been read. " +
+		"The worker will repair one missing evidence group at a time with read_artifact. " +
+		"Preserve every prior evidence token and add the repaired tokens."
+	evidenceRepairExhaustedPrompt = "Deterministic evidence repair is unavailable or exhausted. " +
+		"Do not call artifact readers. Use the evidence tokens already preserved in the Engine evidence ledger, " +
+		"correct evidence_tokens and relevant_files, then retry the validation Tool."
+	invalidAnalysisPrompt = "The final analysis JSON is malformed. Correct the JSON syntax and required field types, " +
+		"then return the complete final JSON object."
+)
+
+type evidenceRepairGroup struct {
+	ID             string
+	CandidatePaths []string
+}
+
+type analysisLoopGuard struct {
+	validationRequired            bool
+	validationToolNames           map[string]bool
+	timelineToolNames             map[string]bool
+	finalizationTools             []llm.Tool
+	evidenceRepairReader          llm.Tool
+	evidenceRepairReaderOK        bool
+	evidenceRepairGroups          []evidenceRepairGroup
+	evidenceRepairGroupIndex      int
+	evidenceRepairAttemptedGroups map[string]bool
+	customTools                   map[string]*corev1alpha1.Tool
+	submissionToolName            string
+	timelineToolName              string
+	validationFailures            map[string]int
+	validationFinalRetries        int
+	transientCritiqueRetries      int
+	emptyFinalRetries             int
+	timelineVerified              bool
+	transientCritiqueEnabled      bool
+	investigationToolCalls        int
+	evidenceRepairToolCalls       int
+	evidenceRepairActive          bool
+	finalizationStarted           bool
+	currentIteration              int
+	maxIterations                 int
+	toolResults                   map[string]string
+	evidenceEntries               []analysisEvidenceEntry
+	evidenceSeen                  map[string]bool
+}
+
+type finalResponseDecision struct {
+	result   string
+	messages []llm.Message
+	retry    bool
+	err      error
+}
+
+type validationInspection struct {
+	execErr error
+	final   string
+	repair  string
+	fatal   error
+}
+
+func agentLoopMaxIterations(coordination workerenv.CoordinationEnv, validationRequired bool) int {
+	maxIterations := 10
+	if coordination.Enabled {
+		maxIterations = 50
+	}
+	if coordination.AutonomousMode {
+		maxIterations = 100
+	}
+	if validationRequired {
+		maxIterations = analysisLoopMaxIterations
+	}
+	return maxIterations
+}
+
+func newAnalysisLoopGuard(
+	tools []llm.Tool,
+	customTools map[string]*corev1alpha1.Tool,
+) *analysisLoopGuard {
+	validation, timeline, finalization := analysisToolNames(tools, customTools)
+	repairReader, repairReaderOK := analysisEvidenceRepairReader(tools, customTools)
+	submissionToolName := defaultSubmissionToolName
+	timelineToolName := defaultTimelineToolName
+	for _, tool := range tools {
+		if validation[tool.Name] && submissionToolName == defaultSubmissionToolName {
+			submissionToolName = tool.Name
+		}
+		if timeline[tool.Name] && timelineToolName == defaultTimelineToolName {
+			timelineToolName = tool.Name
+		}
+	}
+	return &analysisLoopGuard{
+		validationRequired:            len(validation) > 0,
+		validationToolNames:           validation,
+		timelineToolNames:             timeline,
+		transientCritiqueEnabled:      len(timeline) > 0,
+		finalizationTools:             finalization,
+		evidenceRepairReader:          repairReader,
+		evidenceRepairReaderOK:        repairReaderOK,
+		customTools:                   customTools,
+		submissionToolName:            submissionToolName,
+		timelineToolName:              timelineToolName,
+		validationFailures:            map[string]int{},
+		toolResults:                   map[string]string{},
+		evidenceSeen:                  map[string]bool{},
+		evidenceRepairAttemptedGroups: map[string]bool{},
+		currentIteration:              -1,
+		maxIterations:                 analysisLoopMaxIterations,
+	}
+}
+
+func (g *analysisLoopGuard) isValidationTool(name string) bool {
+	return g.validationToolNames[strings.TrimSpace(name)]
+}
+
+func (g *analysisLoopGuard) isTimelineTool(name string) bool {
+	return g.timelineToolNames[strings.TrimSpace(name)]
+}
+
+func (g *analysisLoopGuard) isFinalizationTool(name string) bool {
+	return g.isValidationTool(name) || g.isTimelineTool(name)
+}
+
+func (g *analysisLoopGuard) isEvidenceRepairTool(name string) bool {
+	return g.evidenceRepairReaderOK && strings.TrimSpace(name) == g.evidenceRepairReader.Name
+}
+
+func (g *analysisLoopGuard) prepareRequest(
+	req *llm.CompletionRequest,
+	messages []llm.Message,
+	iteration, maxIterations int,
+) {
+	g.currentIteration = iteration
+	g.maxIterations = maxIterations
+	requestMessages := g.withEvidenceLedger(messages)
+	req.Messages = requestMessages
+	if g.timelineVerified {
+		req.Tools = g.withoutTimelineTools(req.Tools)
+	}
+	if g.validationRequired && g.finalizationStarted {
+		if g.evidenceRepairActive && g.evidenceRepairCanContinue(maxIterations-iteration) {
+			req.Tools = g.activeEvidenceRepairTools()
+			req.Messages = appendPrompt(requestMessages, g.currentEvidenceRepairPrompt())
+			return
+		}
+		g.evidenceRepairActive = false
+		req.Tools = g.activeFinalizationTools()
+		req.Messages = appendPrompt(requestMessages, g.modelPrompt(validationFocusPrompt))
+		return
+	}
+	budgetReached := iteration >= maxIterations-analysisValidationFocusRounds ||
+		g.investigationToolCalls >= analysisMaxInvestigationToolCalls
+	if g.validationRequired && budgetReached {
+		req.Tools = g.activeFinalizationTools()
+		req.Messages = appendPrompt(requestMessages, g.modelPrompt(validationFocusPrompt))
+		return
+	}
+	if !g.validationRequired && iteration >= maxIterations-2 {
+		req.Tools = nil
+		req.Messages = appendPrompt(requestMessages, toolsFreeFinalPrompt)
+	}
+}
+
+func (g *analysisLoopGuard) handleFinalResponse(
+	content string,
+	iteration, maxIterations int,
+	messages []llm.Message,
+) finalResponseDecision {
+	if g.validationRequired {
+		g.validationFinalRetries++
+		if g.validationFinalRetries > maxValidationFinalRetries {
+			return finalResponseDecision{err: fmt.Errorf("analysis ended without successful validate_analysis")}
+		}
+		return finalResponseDecision{
+			messages: append(messages,
+				llm.Message{Role: "assistant", Content: content},
+				llm.Message{Role: "user", Content: g.modelPrompt(validationRequiredPrompt)},
+			),
+			retry: true,
+		}
+	}
+	if strings.TrimSpace(content) == "" {
+		if g.emptyFinalRetries >= maxEmptyFinalRetries || iteration >= maxIterations-1 {
+			return finalResponseDecision{err: fmt.Errorf("model returned an empty final response")}
+		}
+		g.emptyFinalRetries++
+		return finalResponseDecision{
+			messages: append(messages,
+				llm.Message{Role: "assistant", Content: content},
+				llm.Message{Role: "user", Content: emptyFinalPrompt},
+			),
+			retry: true,
+		}
+	}
+	if !g.transientCritiqueEnabled {
+		return finalResponseDecision{result: content}
+	}
+	transient, analysisLike, parseErr := analysisTransientState(content)
+	if analysisLike && parseErr != nil {
+		if g.transientCritiqueRetries >= maxTransientCritiqueRetries || iteration >= maxIterations-1 {
+			return finalResponseDecision{err: parseErr}
+		}
+		g.transientCritiqueRetries++
+		return finalResponseDecision{
+			messages: append(messages,
+				llm.Message{Role: "assistant", Content: content},
+				llm.Message{Role: "user", Content: invalidAnalysisPrompt},
+			),
+			retry: true,
+		}
+	}
+	if transient && !g.timelineVerified {
+		if g.transientCritiqueRetries >= maxTransientCritiqueRetries || iteration >= maxIterations-1 {
+			return finalResponseDecision{err: fmt.Errorf("transient verdict lacked successful verify_timeline")}
+		}
+		g.transientCritiqueRetries++
+		return finalResponseDecision{
+			messages: append(messages,
+				llm.Message{Role: "assistant", Content: content},
+				llm.Message{Role: "user", Content: g.modelPrompt(transientCritiquePrompt)},
+			),
+			retry: true,
+		}
+	}
+	return finalResponseDecision{result: content}
+}
+
+func (g *analysisLoopGuard) inspectTool(
+	toolName string,
+	args json.RawMessage,
+	result string,
+	execErr error,
+	completed bool,
+) validationInspection {
+	inspection := validationInspection{execErr: execErr}
+	if g.evidenceRepairActive && g.isEvidenceRepairTool(toolName) {
+		g.completeEvidenceRepairCall(toolName, args, result, completed, execErr)
+	}
+	if g.isValidationTool(toolName) {
+		g.finalizationStarted = true
+	}
+	if inspection.execErr == nil && completed {
+		if g.isTimelineTool(toolName) {
+			g.timelineVerified = true
+		}
+		actualToolName := resolvedCustomToolName(toolName, g.customTools)
+		final, validationCall, validationErr := validatedAnalysisResult(actualToolName, args, result)
+		if validationCall {
+			inspection.execErr = validationErr
+			inspection.final = final
+		}
+	}
+	if inspection.execErr == nil || !g.isValidationTool(toolName) {
+		return inspection
+	}
+	failure := normalizedValidationFailure(inspection.execErr)
+	g.evidenceRepairActive = g.activateEvidenceRepair(failure)
+	g.validationFailures[failure]++
+	inspection.repair = validationRepairPrompt(toolName, failure, g.evidenceRepairActive)
+	if g.validationFailures[failure] >= maxValidationFailures {
+		inspection.fatal = fmt.Errorf(
+			"validate_analysis repeated the same failure %d times: %s",
+			g.validationFailures[failure],
+			failure,
+		)
+	}
+	return inspection
+}
+
+type validationEvidenceFailure struct {
+	MissingEvidence           []string            `json:"missing_evidence"`
+	MissingEvidenceCandidates map[string][]string `json:"missing_evidence_candidates"`
+}
+
+func validationEvidenceRepairPlan(failure string) ([]evidenceRepairGroup, bool) {
+	candidate, found := lastJSONObject(failure)
+	if !found {
+		return nil, false
+	}
+	var details validationEvidenceFailure
+	if json.Unmarshal([]byte(candidate), &details) != nil || len(details.MissingEvidence) == 0 {
+		return nil, false
+	}
+	seen := map[string]bool{}
+	groups := make([]evidenceRepairGroup, 0, len(details.MissingEvidence))
+	for _, rawGroup := range details.MissingEvidence {
+		group := strings.TrimSpace(rawGroup)
+		if group == "" || seen[group] {
+			continue
+		}
+		seen[group] = true
+		seenPaths := map[string]bool{}
+		paths := make([]string, 0, len(details.MissingEvidenceCandidates[rawGroup]))
+		for _, rawPath := range details.MissingEvidenceCandidates[rawGroup] {
+			candidatePath, ok := normalizeEvidenceCandidatePath(rawPath)
+			if !ok || seenPaths[candidatePath] {
+				continue
+			}
+			seenPaths[candidatePath] = true
+			paths = append(paths, candidatePath)
+		}
+		if len(paths) == 0 {
+			return nil, false
+		}
+		groups = append(groups, evidenceRepairGroup{ID: group, CandidatePaths: paths})
+	}
+	return groups, len(groups) > 0
+}
+
+func normalizeEvidenceCandidatePath(raw string) (string, bool) {
+	normalized := path.Clean(strings.ReplaceAll(strings.TrimSpace(raw), `\`, "/"))
+	if normalized == "." || normalized == ".." || strings.HasPrefix(normalized, "../") || strings.HasPrefix(normalized, "/") {
+		return "", false
+	}
+	return normalized, true
+}
+
+func validationNeedsEvidenceRepair(failure string) bool {
+	_, ok := validationEvidenceRepairPlan(failure)
+	return ok
+}
+
+func (g *analysisLoopGuard) activateEvidenceRepair(failure string) bool {
+	groups, ok := validationEvidenceRepairPlan(failure)
+	remainingCalls := analysisMaxEvidenceRepairToolCalls - g.evidenceRepairToolCalls
+	availableTurns := g.maxIterations - g.currentIteration - 1
+	if !ok || !g.evidenceRepairReaderOK || len(groups) > remainingCalls ||
+		len(groups)+g.repairFinalizationTurns() > availableTurns || g.repairPlanRepeatsGroup(groups) {
+		g.clearEvidenceRepairPlan()
+		return false
+	}
+	g.evidenceRepairGroups = groups
+	g.evidenceRepairGroupIndex = 0
+	return true
+}
+
+func (g *analysisLoopGuard) repairPlanRepeatsGroup(groups []evidenceRepairGroup) bool {
+	for _, group := range groups {
+		if g.evidenceRepairAttemptedGroups[group.ID] {
+			return true
+		}
+	}
+	return false
+}
+
+func (g *analysisLoopGuard) clearEvidenceRepairPlan() {
+	g.evidenceRepairActive = false
+	g.evidenceRepairGroups = nil
+	g.evidenceRepairGroupIndex = 0
+}
+
+func (g *analysisLoopGuard) repairFinalizationTurns() int {
+	turns := 1
+	if !g.timelineVerified && len(g.timelineToolNames) > 0 {
+		turns++
+	}
+	return turns
+}
+
+func (g *analysisLoopGuard) remainingEvidenceRepairGroups() int {
+	return len(g.evidenceRepairGroups) - g.evidenceRepairGroupIndex
+}
+
+func (g *analysisLoopGuard) evidenceRepairCanContinue(availableTurns int) bool {
+	groups := g.remainingEvidenceRepairGroups()
+	remainingCalls := analysisMaxEvidenceRepairToolCalls - g.evidenceRepairToolCalls
+	return g.evidenceRepairReaderOK && groups > 0 && groups <= remainingCalls &&
+		groups+g.repairFinalizationTurns() <= availableTurns
+}
+
+func (g *analysisLoopGuard) currentEvidenceRepairGroup() (evidenceRepairGroup, bool) {
+	if !g.evidenceRepairActive || g.evidenceRepairGroupIndex >= len(g.evidenceRepairGroups) {
+		return evidenceRepairGroup{}, false
+	}
+	return g.evidenceRepairGroups[g.evidenceRepairGroupIndex], true
+}
+
+func (g *analysisLoopGuard) currentEvidenceRepairPrompt() string {
+	group, ok := g.currentEvidenceRepairGroup()
+	if !ok {
+		return g.modelPrompt(validationFocusPrompt)
+	}
+	args, _ := json.Marshal(map[string]string{"path": group.CandidatePaths[0]})
+	return fmt.Sprintf(
+		"Repair missing evidence group %q now. Call %s exactly once with arguments %s. "+
+			"Do not call finalization or another reader. Preserve every evidence token.",
+		group.ID,
+		g.evidenceRepairReader.Name,
+		args,
+	)
+}
+
+func (g *analysisLoopGuard) correctEvidenceRepairCall(calls []llm.ToolCall) (llm.ToolCall, bool) {
+	group, ok := g.currentEvidenceRepairGroup()
+	if !ok {
+		return llm.ToolCall{}, false
+	}
+	for _, call := range calls {
+		if strings.TrimSpace(call.Name) != g.evidenceRepairReader.Name {
+			continue
+		}
+		callPath, ok := readArtifactCallPath(call.Arguments)
+		if ok && callPath == group.CandidatePaths[0] {
+			return call, true
+		}
+	}
+	return llm.ToolCall{}, false
+}
+
+func (g *analysisLoopGuard) syntheticEvidenceRepairCall() (llm.ToolCall, bool) {
+	group, ok := g.currentEvidenceRepairGroup()
+	if !ok {
+		return llm.ToolCall{}, false
+	}
+	args, err := json.Marshal(map[string]string{"path": group.CandidatePaths[0]})
+	if err != nil {
+		return llm.ToolCall{}, false
+	}
+	return llm.ToolCall{
+		ID:        fmt.Sprintf("analysis-evidence-repair-%d", g.evidenceRepairToolCalls+1),
+		Name:      g.evidenceRepairReader.Name,
+		Arguments: args,
+	}, true
+}
+
+func readArtifactCallPath(args json.RawMessage) (string, bool) {
+	var call struct {
+		Path string `json:"path"`
+	}
+	if json.Unmarshal(args, &call) != nil {
+		return "", false
+	}
+	return normalizeEvidenceCandidatePath(call.Path)
+}
+
+func (g *analysisLoopGuard) completeEvidenceRepairCall(
+	toolName string,
+	args json.RawMessage,
+	result string,
+	completed bool,
+	execErr error,
+) {
+	group, ok := g.currentEvidenceRepairGroup()
+	callPath, pathOK := readArtifactCallPath(args)
+	if !ok || !g.isEvidenceRepairTool(toolName) || !pathOK || callPath != group.CandidatePaths[0] ||
+		execErr != nil || !completed || !successfulEvidenceRepairResult(result) {
+		g.clearEvidenceRepairPlan()
+		return
+	}
+	g.evidenceRepairGroupIndex++
+	if g.evidenceRepairGroupIndex >= len(g.evidenceRepairGroups) {
+		g.clearEvidenceRepairPlan()
+	}
+}
+
+func successfulEvidenceRepairResult(result string) bool {
+	var payload struct {
+		Error         any    `json:"error"`
+		EvidenceToken string `json:"evidence_token"`
+	}
+	return json.Unmarshal([]byte(result), &payload) == nil && payload.Error == nil &&
+		strings.TrimSpace(payload.EvidenceToken) != ""
+}
+
+func validationRepairPrompt(toolName, failure string, evidenceRepairActive bool) string {
+	prompt := toolName + " failed: " + failure +
+		". Correct the exact missing or invalid field and retry with changed arguments. Do not repeat the same call."
+	if validationNeedsEvidenceRepair(failure) {
+		if evidenceRepairActive {
+			prompt += " " + evidenceRepairPrompt
+		} else {
+			prompt += " " + evidenceRepairExhaustedPrompt
+		}
+	}
+	lower := strings.ToLower(failure)
+	if strings.Contains(lower, "relevant_files") && strings.Contains(lower, "required") {
+		prompt += ` Your next call MUST include "relevant_files" as an array. ` +
+			`Preserve every applicable source path you already identified; use "relevant_files": [] only when no source files apply. ` +
+			"Never omit the field and never use null."
+	}
+	return prompt
+}
+
+func (g *analysisLoopGuard) finishValidatedResult(final, repair string) (string, string) {
+	if final == "" {
+		return "", repair
+	}
+	if validatedAnalysisIsTransient(final) && len(g.timelineToolNames) > 0 && !g.timelineVerified {
+		return "", g.modelPrompt(transientValidationPrompt)
+	}
+	return final, repair
+}
+
+func (g *analysisLoopGuard) withoutTimelineTools(tools []llm.Tool) []llm.Tool {
+	out := make([]llm.Tool, 0, len(tools))
+	for _, tool := range tools {
+		if !g.isTimelineTool(tool.Name) {
+			out = append(out, tool)
+		}
+	}
+	return out
+}
+
+func (g *analysisLoopGuard) completedToolCallResult(name string) (string, bool) {
+	if g.timelineVerified && g.isTimelineTool(name) {
+		return "timeline verification already completed; call " + g.submissionToolName + " now", true
+	}
+	return "", false
+}
+
+func (g *analysisLoopGuard) activeFinalizationTools() []llm.Tool {
+	if !g.timelineVerified {
+		return g.finalizationTools
+	}
+	out := make([]llm.Tool, 0, len(g.finalizationTools))
+	for _, tool := range g.finalizationTools {
+		if !g.isTimelineTool(tool.Name) {
+			out = append(out, tool)
+		}
+	}
+	return out
+}
+
+func (g *analysisLoopGuard) activeEvidenceRepairTools() []llm.Tool {
+	if !g.evidenceRepairActive || !g.evidenceRepairReaderOK {
+		return nil
+	}
+	return []llm.Tool{g.evidenceRepairReader}
+}
