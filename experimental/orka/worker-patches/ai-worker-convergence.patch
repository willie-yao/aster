+
+func TestIsVerifyTimelineTool(t *testing.T) {
+	for _, name := range []string{"verify_timeline", "verify-timeline-babc123", "VERIFY_TIMELINE_BABC123"} {
+		if !isVerifyTimelineTool(name) {
+			t.Fatalf("required timeline tool %q was not recognized", name)
+		}
+	}
+	for _, name := range []string{"preverify-timeline-check", "verify_timeline_custom", "verify-timeline" + "-custom"} {
+		if isVerifyTimelineTool(name) {
+			t.Fatalf("unrelated tool %q was recognized as verify_timeline", name)
+		}
+	}
+}
+
+type retryTimelineTool struct {
+	calls int
+}
+
+func (*retryTimelineTool) Name() string        { return "verify_timeline" }
+func (*retryTimelineTool) Description() string { return "test timeline tool" }
+func (*retryTimelineTool) Parameters() json.RawMessage {
+	return json.RawMessage(`{"type":"object","properties":{}}`)
+}
+func (tool *retryTimelineTool) Execute(context.Context, json.RawMessage) (string, error) {
+	tool.calls++
+	if tool.calls == 1 {
+		return "timeline verified", nil
+	}
+	return "", errors.New("timeline unavailable")
+}
+
+func TestExecuteAgentLoopRepromptsAfterFailedTimelineRetry(t *testing.T) {
+	restore := replaceDefaultToolRegistryForTest(t)
+	defer restore()
+	timeline := &retryTimelineTool{}
+	toolspkg.DefaultRegistry.Register(timeline)
+	llmTools := toolspkg.DefaultRegistry.ToLLMTools([]string{timeline.Name()})
+	provider := &sequenceProvider{responses: []*llm.CompletionResponse{
+		{
+			Content:    "checking timeline",
+			ToolCalls:  []llm.ToolCall{{ID: "timeline-1", Name: timeline.Name(), Arguments: json.RawMessage(`{}`)}},
+			StopReason: "tool_use",
+			Model:      "test-model",
+		},
+		{
+			Content:    "retrying timeline",
+			ToolCalls:  []llm.ToolCall{{ID: "timeline-2", Name: timeline.Name(), Arguments: json.RawMessage(`{}`)}},
+			StopReason: "tool_use",
+			Model:      "test-model",
+		},
+		{Content: `{"summary":"analysis","is_transient":true}`, StopReason: "end_turn", Model: "test-model"},
+		{Content: `{"summary":"analysis","is_transient":false}`, StopReason: "end_turn", Model: "test-model"},
+	}}
+	result, err := executeAgentLoopWithEvents(
+		context.Background(), provider, []llm.Message{{Role: "user", Content: "classify"}},
+		"", "test-model", llmTools, nil, nil, common.NewFakeEventRecorder(),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result != `{"summary":"analysis","is_transient":false}` || provider.callCount != 4 {
+		t.Fatalf("result = %q, calls = %d, want corrected verdict after failed timeline retry", result, provider.callCount)
+	}
+}
+
+func TestExecuteAgentLoopRejectsRepeatedEmptyFinal(t *testing.T) {
+	provider := &sequenceProvider{responses: []*llm.CompletionResponse{
+		{Content: "", StopReason: "end_turn", Model: "test-model"},
+		{Content: "", StopReason: "end_turn", Model: "test-model"},
+	}}
+	result, err := executeAgentLoopWithEvents(
+		context.Background(), provider, []llm.Message{{Role: "user", Content: "analyze"}},
+		"", "test-model", nil, nil, nil, common.NewFakeEventRecorder(),
+	)
+	if err == nil || !strings.Contains(err.Error(), "empty final response") {
+		t.Fatalf("result = %q, error = %v, want repeated-empty failure", result, err)
+	}
+	if provider.callCount != 2 {
+		t.Fatalf("provider calls = %d, want 2", provider.callCount)
+	}
+}
+
+func TestExecuteAgentLoopRejectsRepeatedUnsupportedTransient(t *testing.T) {
+	provider := &sequenceProvider{responses: []*llm.CompletionResponse{
+		{Content: `{"summary":"analysis","is_transient":true}`, StopReason: "end_turn", Model: "test-model"},
+		{Content: `{"summary":"analysis","is_transient":true}`, StopReason: "end_turn", Model: "test-model"},
+		{Content: `{"summary":"analysis","is_transient":true}`, StopReason: "end_turn", Model: "test-model"},
+	}}
+	result, err := executeAgentLoopWithEvents(
+		context.Background(), provider, []llm.Message{{Role: "user", Content: "classify"}},
+		"", "test-model", nil, nil, nil, common.NewFakeEventRecorder(),
+	)
+	if err == nil || !strings.Contains(err.Error(), "lacked verify_timeline") {
+		t.Fatalf("result = %q, error = %v, want unsupported-transient failure", result, err)
+	}
+	if provider.callCount != 3 {
+		t.Fatalf("provider calls = %d, want 3", provider.callCount)
+	}
+}
