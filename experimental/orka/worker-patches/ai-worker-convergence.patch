+++ b/workers/ai/analysis_budget_test.go
@@ -0,0 +1,470 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	corev1alpha1 "github.com/orka-agents/orka/api/v1alpha1"
+	"github.com/orka-agents/orka/internal/llm"
+	"github.com/orka-agents/orka/internal/worker"
+)
+
+const testSubmissionToolName = "submit_analysis"
+
+func evidenceRepairFailure(groups ...string) string {
+	candidates := map[string][]string{}
+	for _, group := range groups {
+		candidates[group] = []string{"logs/" + group + ".log"}
+	}
+	body, _ := json.Marshal(validationEvidenceFailure{
+		MissingEvidence:           groups,
+		MissingEvidenceCandidates: candidates,
+	})
+	return "tool returned HTTP 422: " + string(body)
+}
+
+func evidenceRepairCallPath(t *testing.T, call llm.ToolCall) string {
+	t.Helper()
+	candidate, ok := readArtifactCallPath(call.Arguments)
+	if !ok {
+		t.Fatalf("repair call arguments = %s", call.Arguments)
+	}
+	return candidate
+}
+
+func completeEvidenceRepairCall(t *testing.T, guard *analysisLoopGuard, call llm.ToolCall) {
+	t.Helper()
+	if err := guard.beginToolCall(call.Name); err != nil {
+		t.Fatal(err)
+	}
+	inspection := guard.inspectTool(call.Name, call.Arguments, `{"evidence_token":"signed"}`, nil, true)
+	if inspection.execErr != nil {
+		t.Fatal(inspection.execErr)
+	}
+}
+
+func TestAnalysisLoopGuardSelectsOneToolCall(t *testing.T) {
+	guard := newAnalysisLoopGuard([]llm.Tool{
+		{Name: testSubmissionToolName},
+		{Name: "verify_timeline"},
+	}, nil)
+	calls := []llm.ToolCall{
+		{Name: "read_artifact"},
+		{Name: testSubmissionToolName},
+		{Name: "verify_timeline"},
+	}
+	got := guard.selectToolCalls(calls)
+	if len(got) != 1 || got[0].Name != "verify_timeline" {
+		t.Fatalf("selected calls = %+v", got)
+	}
+	got = guard.selectToolCalls(calls[:2])
+	if len(got) != 1 || got[0].Name != testSubmissionToolName {
+		t.Fatalf("selected calls = %+v", got)
+	}
+}
+
+func TestAnalysisLoopGuardToolCallResetsValidationFinalRetries(t *testing.T) {
+	guard := newAnalysisLoopGuard([]llm.Tool{
+		{Name: "read_artifact"},
+		{Name: testSubmissionToolName},
+	}, nil)
+	guard.validationFinalRetries = maxValidationFinalRetries
+	if err := guard.beginToolCall("read_artifact"); err != nil {
+		t.Fatal(err)
+	}
+	if guard.validationFinalRetries != 0 {
+		t.Fatalf("validation final retries = %d, want 0", guard.validationFinalRetries)
+	}
+	guard.validationFinalRetries = maxValidationFinalRetries
+	if err := guard.beginToolCall(testSubmissionToolName); err != nil {
+		t.Fatal(err)
+	}
+	if guard.validationFinalRetries != 0 {
+		t.Fatalf("validation final retries after submission = %d, want 0", guard.validationFinalRetries)
+	}
+}
+
+func TestAnalysisLoopGuardUsesToolCallBudget(t *testing.T) {
+	guard := newAnalysisLoopGuard([]llm.Tool{
+		{Name: "read_artifact"},
+		{Name: testSubmissionToolName},
+	}, nil)
+	for range analysisMaxInvestigationToolCalls {
+		if err := guard.beginToolCall("read_artifact"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := guard.beginToolCall("read_artifact"); err == nil {
+		t.Fatal("tool-call budget allowed an extra investigation call")
+	}
+	req := &llm.CompletionRequest{Tools: []llm.Tool{
+		{Name: "read_artifact"},
+		{Name: testSubmissionToolName},
+	}}
+	guard.prepareRequest(req, nil, 1, analysisLoopMaxIterations)
+	if len(req.Tools) != 1 || req.Tools[0].Name != testSubmissionToolName {
+		t.Fatalf("budgeted tools = %+v", req.Tools)
+	}
+}
+
+func TestAnalysisLoopGuardRepairsMissingGroupsInOrder(t *testing.T) {
+	guard := newAnalysisLoopGuard([]llm.Tool{
+		{Name: "read_artifact"},
+		{Name: testSubmissionToolName},
+	}, nil)
+	failure := evidenceRepairFailure("machine-state", "node-state", "controller-log")
+	inspection := guard.inspectTool(testSubmissionToolName, nil, "", fmt.Errorf("%s", failure), false)
+	if inspection.repair == "" || !guard.evidenceRepairActive || !guard.finalizationStarted {
+		t.Fatalf("inspection = %+v repair active=%t finalization started=%t", inspection, guard.evidenceRepairActive, guard.finalizationStarted)
+	}
+	var got []string
+	for range 3 {
+		selected := guard.selectToolCalls(nil)
+		if len(selected) != 1 {
+			t.Fatalf("selected repair calls = %+v", selected)
+		}
+		got = append(got, evidenceRepairCallPath(t, selected[0]))
+		completeEvidenceRepairCall(t, guard, selected[0])
+	}
+	want := []string{"logs/machine-state.log", "logs/node-state.log", "logs/controller-log.log"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("repair paths = %v, want %v", got, want)
+	}
+	if guard.evidenceRepairActive {
+		t.Fatal("repair remained active after every group was covered")
+	}
+}
+
+func TestAnalysisLoopGuardFocusLeavesTimelineFourRepairsAndSubmissionRounds(t *testing.T) {
+	guard := newAnalysisLoopGuard([]llm.Tool{
+		{Name: "read_artifact"},
+		{Name: "verify_timeline"},
+		{Name: testSubmissionToolName},
+	}, nil)
+	firstFocusIteration := analysisLoopMaxIterations - analysisValidationFocusRounds
+	req := &llm.CompletionRequest{Tools: []llm.Tool{
+		{Name: "read_artifact"},
+		{Name: "verify_timeline"},
+		{Name: testSubmissionToolName},
+	}}
+	guard.prepareRequest(req, nil, firstFocusIteration, analysisLoopMaxIterations)
+	allowed := advertisedToolNames(req.Tools)
+	if _, ok := allowed["verify_timeline"]; !ok {
+		t.Fatalf("first focus tools = %+v, missing timeline", req.Tools)
+	}
+	guard.inspectTool("verify_timeline", nil, "verified", nil, true)
+
+	req.Tools = []llm.Tool{{Name: "read_artifact"}, {Name: "verify_timeline"}, {Name: testSubmissionToolName}}
+	guard.prepareRequest(req, nil, firstFocusIteration+1, analysisLoopMaxIterations)
+	if len(req.Tools) != 1 || req.Tools[0].Name != testSubmissionToolName {
+		t.Fatalf("initial submission tools = %+v", req.Tools)
+	}
+	failure := evidenceRepairFailure("one", "two", "three", "four")
+	guard.inspectTool(testSubmissionToolName, nil, "", fmt.Errorf("%s", failure), false)
+	if !guard.evidenceRepairActive {
+		t.Fatal("four-group repair did not activate")
+	}
+
+	for repair := range analysisMaxEvidenceRepairToolCalls {
+		iteration := firstFocusIteration + 2 + repair
+		req.Tools = []llm.Tool{{Name: "read_artifact"}, {Name: "verify_timeline"}, {Name: testSubmissionToolName}}
+		guard.prepareRequest(req, nil, iteration, analysisLoopMaxIterations)
+		if len(req.Tools) != 1 || req.Tools[0].Name != "read_artifact" {
+			t.Fatalf("repair round %d tools = %+v", repair+1, req.Tools)
+		}
+		selected := guard.selectToolCalls(nil)
+		completeEvidenceRepairCall(t, guard, selected[0])
+	}
+
+	finalIteration := firstFocusIteration + 2 + analysisMaxEvidenceRepairToolCalls
+	if finalIteration != analysisLoopMaxIterations-1 {
+		t.Fatalf("final iteration = %d, want %d", finalIteration, analysisLoopMaxIterations-1)
+	}
+	req.Tools = []llm.Tool{{Name: "read_artifact"}, {Name: "verify_timeline"}, {Name: testSubmissionToolName}}
+	guard.prepareRequest(req, nil, finalIteration, analysisLoopMaxIterations)
+	if len(req.Tools) != 1 || req.Tools[0].Name != testSubmissionToolName {
+		t.Fatalf("final repaired submission tools = %+v", req.Tools)
+	}
+}
