+func (p *repairRecordingProvider) Complete(_ context.Context, req *llm.CompletionRequest) (*llm.CompletionResponse, error) {
+	copyReq := *req
+	copyReq.Messages = append([]llm.Message(nil), req.Messages...)
+	p.requests = append(p.requests, &copyReq)
+	if len(p.responses) == 0 {
+		return &llm.CompletionResponse{Content: "unexpected"}, nil
+	}
+	response := p.responses[0]
+	p.responses = p.responses[1:]
+	return response, nil
