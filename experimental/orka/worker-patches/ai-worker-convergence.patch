+// transientWithoutTimeline reports whether the final answer claims
+// is_transient=true while the model never called verify_timeline to confirm it.
+// It backs the critique gate: a transient verdict must be earned with a timeline
+// confirmation, matching the engine's "default to bug unless proven" contract.
+func transientWithoutTimeline(content string, timelineVerified bool) bool {
+	return responseClaimsTransient(content) && !timelineVerified
+}
+
+func isVerifyTimelineTool(name string) bool {
+	normalized := strings.ReplaceAll(strings.ToLower(strings.TrimSpace(name)), "-", "_")
+	return normalized == "verify_timeline" || strings.HasPrefix(normalized, "verify_timeline_b")
+}
+
+type analysisCandidate struct {
+	Summary     string `json:"summary"`
+	RootCause   string `json:"root_cause"`
+	Severity    string `json:"severity"`
+	IsTransient *bool  `json:"is_transient"`
+}
+
+func responseClaimsTransient(content string) bool {
+	var best *analysisCandidate
+	depth, start := 0, -1
+	inString, escaped := false, false
+	for i := 0; i < len(content); i++ {
+		ch := content[i]
+		if inString {
+			switch {
+			case escaped:
+				escaped = false
+			case ch == '\\':
+				escaped = true
+			case ch == '"':
+				inString = false
+			}
+			continue
+		}
+		if ch == '"' {
+			inString = true
+			continue
+		}
+		switch ch {
+		case '{':
+			if depth == 0 {
+				start = i
+			}
+			depth++
+		case '}':
+			if depth > 0 {
+				depth--
+				if depth == 0 && start >= 0 {
+					var candidate analysisCandidate
+					if json.Unmarshal([]byte(content[start:i+1]), &candidate) == nil && candidate.shaped() {
+						best = &candidate
+					}
+				}
+			}
+		}
+	}
+	return best != nil && best.IsTransient != nil && *best.IsTransient
+}
+
+func (candidate analysisCandidate) shaped() bool {
+	return strings.TrimSpace(candidate.Summary) != "" ||
+		strings.TrimSpace(candidate.RootCause) != "" ||
+		strings.TrimSpace(candidate.Severity) != ""
+}
