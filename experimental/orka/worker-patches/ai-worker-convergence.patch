+
+func TestExecuteAgentLoopRepromptsEmptyFinal(t *testing.T) {
+	provider := &sequenceProvider{responses: []*llm.CompletionResponse{
+		{Content: "", StopReason: "end_turn", Model: "test-model"},
+		{Content: "final result", StopReason: "end_turn", Model: "test-model"},
+	}}
+	result, err := executeAgentLoopWithEvents(
+		context.Background(), provider, []llm.Message{{Role: "user", Content: "analyze"}},
+		"", "test-model", nil, nil, nil, common.NewFakeEventRecorder(),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result != "final result" || provider.callCount != 2 {
+		t.Fatalf("result = %q, calls = %d, want final result after one re-prompt", result, provider.callCount)
+	}
+}
+
+func TestTransientWithoutTimeline(t *testing.T) {
+	for _, content := range []string{
+		`{"summary":"analysis","is_transient":true}`,
+		`{ "summary":"analysis", "is_transient" : true }`,
+		`{"SUMMARY":"analysis","IS_TRANSIENT": true}`,
+		"```json\n{\"summary\":\"analysis\",\"Is_Transient\": true}\n```",
+		`{"status":"thinking"} {"summary":"final","is_transient":true}`,
+		`{"summary":"unexpected } in log","is_transient":true}`,
+		`{"summary":"escaped \" } in log","is_transient":true}`,
+		`{"summary":"analysis","is_transient":false,"IS_TRANSIENT":true}`,
+	} {
+		if !transientWithoutTimeline(content, false) {
+			t.Fatalf("transient verdict %q was accepted", content)
+		}
+	}
+	for _, content := range []string{
+		`{"summary":"analysis","is_transient":false}`,
+		`{"summary":"analysis","is_transient":"true"}`,
+		`{"summary":"analysis","nested":{"is_transient":true}}`,
+		`not json`,
+		`{"summary":"first","is_transient":true} {"summary":"final","is_transient":false}`,
+		`{"summary":"analysis","is_transient":true,"IS_TRANSIENT":false}`,
+	} {
+		if transientWithoutTimeline(content, false) {
+			t.Fatalf("non-transient verdict %q was rejected", content)
+		}
+	}
+	if transientWithoutTimeline(`{"summary":"analysis","IS_TRANSIENT":true}`, true) {
+		t.Fatal("verified transient verdict was rejected")
+	}
+}
