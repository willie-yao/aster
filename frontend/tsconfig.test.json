{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "node_modules/.tmp/test-dist"
  },
  "include": [
    "tests/**/*.ts",
    "src/lib/analysisChat.ts",
    "src/lib/pageMetadata.ts",
    "src/lib/routes.ts",
    "src/lib/fetchStatus.ts",
    "src/lib/testResults.ts",
    "src/lib/buildFailures.ts",
    "src/types/dashboard.ts",
    "src/types/analysisChat.ts",
    "src/types/fetchStatus.ts",
    "src/lib/actionRequests.ts",
    "src/types/actions.ts"
  ]
}
